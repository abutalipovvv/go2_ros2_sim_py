<!-- FRONT ENTRY / OFFICE CLOSETS                       -->
<!-- Entry closet opens LEFT, office closet opens RIGHT -->
<!-- ================================================= -->
<model name="front_entry_closets">
  <static>true</static>
  <pose>-7.9575 -6.8025 0 0 0 0</pose>

  <link name="closets">

    <!-- Shared divider between the two closets -->
    <collision name="closet_divider_collision">
      <pose>9.03 1.4625 1.25 0 0 0</pose>
      <geometry>
        <box><size>0.12 2.805 2.5</size></box>
